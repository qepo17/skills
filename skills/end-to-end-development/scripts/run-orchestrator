#!/usr/bin/env bash
set -euo pipefail

SKILL_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-${XDG_CACHE_HOME:-$HOME/.cache}/pi/end-to-end-development/venv}"

exec uv run --project "$SKILL_DIR" python "$SKILL_DIR/scripts/orchestrator.py" "$@"
